# Copy to .env to override the docker compose defaults. Defaults are development-only values.
WEB_PORT=18440
ORACLE_PORT=15240
ORACLE_PASSWORD=sys-dev-only
OWNER_PASSWORD=OwnerDev1
APP_PASSWORD=AppDev1

# Generate your own: WEBHOOK_SECRET="whsec_$(openssl rand -base64 32)", KEK_BASE64="$(openssl rand -base64 32)"
# WEBHOOK_SECRET=
# PROVIDER_WEBHOOK_SECRET=
# KEK_ID=kek-2026-11
# KEK_BASE64=
# BLIND_INDEX_KEY_BASE64=

VISITS_PER_MINUTE=30

# Set to export traces/metrics to an OTLP collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
